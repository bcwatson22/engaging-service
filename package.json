{
  "name": "engaging-service",
  "version": "0.1.0",
  "private": true,
  "description": "Render service for engaging.engineering — queued headless-Chrome artifacts",
  "license": "UNLICENSED",
  "author": "Billy Watson <hello@engaging.engineering> (https://www.engaging.engineering)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && find dist -name '*.spec.js*' -delete",
    "start": "node dist/main",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@hygraph/utils": "^1.2.1",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/terminus": "11.1.1",
    "bullmq": "6.1.0",
    "ioredis": "6.0.0",
    "puppeteer": "25.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.15.47",
    "@types/node": "26.2.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.10",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "puppeteer"
    ]
  }
}
