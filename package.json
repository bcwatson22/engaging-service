{
  "name": "engaging-service",
  "version": "0.1.0",
  "private": true,
  "description": "Request-time tier for engaging.engineering — contact, status, integrity and dead links",
  "license": "UNLICENSED",
  "author": "Billy Watson <hello@engaging.engineering> (https://www.engaging.engineering)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && find dist -name '*.spec.js*' -delete",
    "start": "node dist/main",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:scripts": "node --input-type=module -e \"await import('./src/dependencies/plan.ts')\"",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:scripts && pnpm coverage && pnpm build"
  },
  "dependencies": {
    "@hygraph/utils": "1.2.1",
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/schematics": "12.0.4",
    "@nestjs/testing": "12.0.4",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.10",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  }
}
