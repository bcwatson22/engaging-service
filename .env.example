# Copy to .env and fill in. Validated at boot by src/config/env.schema.ts,
# so a missing or malformed value fails startup rather than a later request.

NODE_ENV=development
PORT=3000

# The deployed site the renderer navigates to. No trailing slash.
SITE_URL=https://www.engaging.engineering

# Local development: docker run -d -p 6379:6379 redis:7-alpine
# Deployed: the Upstash connection string.
REDIS_URL=redis://127.0.0.1:6379

# Guards POST /render. Generate with: openssl rand -hex 32
RENDER_SECRET=

# The secret configured on the Hygraph webhook, which signs each payload.
HYGRAPH_WEBHOOK_SECRET=

# Cloudflare R2. Account id is on the R2 overview page; the key pair comes
# from an R2 API token scoped to the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=engaging-artifacts
R2_PUBLIC_BASE=
